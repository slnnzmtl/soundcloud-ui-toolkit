{
  "manifest_version": 3,
  "name": "SoundCloud Style Overrides",
  "version": "1.1.0",
  "description": "Applies a configurable visual theme to soundcloud.com.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SoundCloud Style Overrides"
  },
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*"],
      "css": ["styles.css"],
      "js": ["shared/settings.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
